# Base URL of the auction API.
#
# Read in the BROWSER, so it must be prefixed NEXT_PUBLIC_ — and note that
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime. Changing this on Vercel requires a redeploy, not a restart.
#
# Local:  http://localhost:4000
# Vercel: https://auction-api-<you>.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000
